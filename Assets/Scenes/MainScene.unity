--- !u!114 &973772994
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 973772992}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c66e8bf0732e2e4a89b1f2825d6921c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameRulesPopupController
  titleText: {fileID: 1056723172}
  bodyText: {fileID: 1482875713}
  pageText: {fileID: 1277191282}
  previousButton: {fileID: 630177707}
  nextButton: {fileID: 1002158192}
  pages:
  - title: "\uAC8C\uC784 \uC18C\uAC1C"
    body: "\uC9C8\uBB38\uACFC \uC81C\uC2DC\uC5B4\uB97C \uC5F0\uACB0\uD574 \uADF8\uB9BC\uC744
      \uADF8\uB9AC\uACE0, \uC81C\uC2DC\uC5B4\uB97C \uBAA8\uB974\uB294 \u2018\uC0AC\uC9DC
      \uD654\uAC00\u2019\uB97C \uCC3E\uC544\uB0B4\uC138\uC694!\n\n\uCC38\uC5EC \uC778\uC6D0:
      4~8\uBA85 / \uD55C \uAC8C\uC784: \uCD1D 2\uB77C\uC6B4\uB4DC\n\n4\uBA85: \uC0AC\uC9DC
      \uD654\uAC00 1\uBA85, \uAC10\uC815\uAC00 1\uBA85, \uC2DC\uBBFC 2\uBA85\n5\uBA85
      \uC774\uC0C1: \uC0AC\uC9DC \uD654\uAC00 1\uBA85, \uAC10\uC815\uAC00 1\uBA85
      \uACE0\uC815\n\uC54C\uCF54\uC62C \uC911\uB3C5 \uD654\uAC00 0~1\uBA85 \uBB34\uC791\uC704
      \uBC30\uC815, \uB098\uBA38\uC9C0\uB294 \uC2DC\uBBFC\n\n\uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uAC00
      \uC900\uBE44\uD558\uBA74 \uD638\uC2A4\uD2B8\uAC00 \uAC8C\uC784\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - title: "\uC2DC\uBBFC"
    body: "\uACF5\uD1B5 \uC81C\uC2DC\uC5B4\uB97C \uC54C\uACE0 \uC2DC\uC791\uD558\uB294
      \uC2DC\uBBFC \uD300\uC785\uB2C8\uB2E4.\n\n\uC9C8\uBB38\uACFC \uC790\uC2E0\uC758
      \uC81C\uC2DC\uC5B4\uB97C \uC5F0\uACB0\uD574 \uADF8\uB9BC\uC744 \uADF8\uB9AC\uC138\uC694.\n\uB2E4\uB978
      \uC0AC\uB78C\uC758 \uADF8\uB9BC\uACFC \uC124\uBA85\uC744 \uC0B4\uD3B4\uBCF4\uACE0
      \uC0AC\uC9DC \uD654\uAC00\uB97C \uCD94\uB9AC\uD558\uC138\uC694.\n\n\uC2B9\uB9AC
      \uC870\uAC74\n\uC0AC\uC9DC \uD654\uAC00\uAC00 \uC81C\uC2DC\uC5B4\uB97C \uB9DE\uD788\uC9C0
      \uBABB\uD55C \uC0C1\uD0DC\uC5D0\uC11C,\n\uCD5C\uC885 \uD22C\uD45C\uB85C \uC0AC\uC9DC
      \uD654\uAC00\uB97C \uC9C0\uBAA9\uD558\uBA74 \uC2DC\uBBFC \uD300\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
  - title: "\uAC10\uC815\uAC00"
    body: "\uC2DC\uBBFC\uACFC \uAC19\uC740 \uC81C\uC2DC\uC5B4\uB97C \uBC1B\uB294
      \uC2DC\uBBFC \uD300\uC785\uB2C8\uB2E4.\n\n\uAC80\uC99D \uC2DC\uAC04\uC5D0 \uC6D0\uD558\uB294
      \uC120\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uACE0 \uD074\uB9AD\uD558\uBA74\n\uADF8
      \uC120\uC744 \uADF8\uB9B0 \uD50C\uB808\uC774\uC5B4\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB2A5\uB825\uC740 \uB77C\uC6B4\uB4DC\uB9C8\uB2E4
      1\uD68C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC73C\uBA70,\n2\uB77C\uC6B4\uB4DC\uAC00
      \uC2DC\uC791\uB418\uBA74 \uB2E4\uC2DC 1\uD68C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC2B9\uB9AC
      \uC870\uAC74\uC740 \uC2DC\uBBFC\uACFC \uAC19\uC2B5\uB2C8\uB2E4."
  - title: "\uC0AC\uC9DC \uD654\uAC00"
    body: "\uC81C\uC2DC\uC5B4\uB97C \uBC1B\uC9C0 \uBABB\uD558\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4.\n\n\uC9C8\uBB38\uACFC
      \uB2E4\uB978 \uC0AC\uB78C\uC758 \uADF8\uB9BC\uC744 \uBCF4\uBA70 \uC81C\uC2DC\uC5B4\uB97C
      \uC720\uCD94\uD558\uACE0,\n\uC815\uCCB4\uB97C \uC228\uAE30\uBA74\uC11C \uC790\uC5F0\uC2A4\uB7FD\uAC8C
      \uADF8\uB9BC\uC744 \uADF8\uB9AC\uC138\uC694.\n\n\uAC01 \uB77C\uC6B4\uB4DC\uC758
      \uAC80\uC99D \uC2DC\uAC04\uC5D0 \uC81C\uC2DC\uC5B4 \uB9DE\uD788\uAE30 \uD31D\uC5C5\uC774
      \uC5F4\uB9BD\uB2C8\uB2E4.\n\uC2DC\uAC04 \uC548\uC5D0\uB294 \uD69F\uC218 \uC81C\uD55C
      \uC5C6\uC774 \uB3C4\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC815\uB2F5\uC744
      \uB9DE\uD788\uBA74 \uC989\uC2DC \uC0AC\uC9DC \uD654\uAC00\uC758 \uC2B9\uB9AC\uB85C
      \uB05D\uB0A9\uB2C8\uB2E4!\n\n\uC815\uB2F5\uC744 \uBABB \uB9DE\uD788\uACE0 \uCD5C\uC885
      \uD22C\uD45C\uB85C \uC9C0\uBAA9\uB418\uBA74 \uD328\uBC30,\n\uB2E4\uB978 \uC0AC\uB78C\uC774
      \uC9C0\uBAA9\uB418\uBA74 \uC804\uC6D0 \uBB34\uC2B9\uBD80\uC785\uB2C8\uB2E4."
  - title: "\uC54C\uCF54\uC62C \uC911\uB3C5 \uD654\uAC00"
    body: "\uC790\uC2E0\uB3C4 \uBAA8\uB974\uAC8C \uB2E4\uB978 \uC81C\uC2DC\uC5B4\uB97C
      \uBC1B\uC740 \uC2DC\uBBFC \uD300\uC785\uB2C8\uB2E4.\n\n\uC77C\uBC18 \uC2DC\uBBFC\uACFC
      \uB2E4\uB978 \uC81C\uC2DC\uC5B4\uB97C \uBC1B\uC9C0\uB9CC,\n\uBCF8\uC778\uC5D0\uAC8C\uB294
      \uC9C1\uC5C5\uC774 \u2018\uC2DC\uBBFC\u2019\uC73C\uB85C \uC548\uB0B4\uB429\uB2C8\uB2E4.\n\uC790\uC2E0\uC774
      \uC54C\uCF54\uC62C \uC911\uB3C5 \uD654\uAC00\uC778\uC9C0 \uC54C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uC790\uC2E0\uC5D0\uAC8C
      \uC8FC\uC5B4\uC9C4 \uC81C\uC2DC\uC5B4\uB97C \uAE30\uC900\uC73C\uB85C \uADF8\uB9BC\uC744
      \uADF8\uB9AC\uC138\uC694.\n\uB2E4\uB978 \uC0AC\uB78C\uACFC \uADF8\uB9BC\uC758
      \uBC29\uD5A5\uC774 \uB2EC\uB77C\uB3C4 \uC0AC\uC9DC\uAC00 \uC544\uB2D0 \uC218
      \uC788\uC2B5\uB2C8\uB2E4!\n\n\uC2B9\uB9AC \uC870\uAC74\uC740 \uC2DC\uBBFC\uACFC
      \uAC19\uC2B5\uB2C8\uB2E4."
  - title: "\uAC8C\uC784 \uC9C4\uD589 \uC21C\uC11C"
    body: "\u2460 \uC9C1\uC5C5\xB7\uC81C\uC2DC\uC5B4 \uD655\uC778 \u2014 5\uCD08\n\uC790\uC2E0\uC758
      \uC9C1\uC5C5\uACFC \uC81C\uC2DC\uC5B4\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.\n\n\u2461
      \uC9C8\uBB38 \uACF5\uAC1C \u2014 5\uCD08\n\uC9C8\uBB38\uC740 \uACF5\uAC1C \uC774\uD6C4\uC5D0\uB3C4
      \uD654\uBA74\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n\u2462 \uADF8\uB9BC \uADF8\uB9AC\uAE30
      \u2014 \uD55C \uBA85\uB2F9 15\uCD08\n\uBB34\uC791\uC704 \uC21C\uC11C\uB85C
      \uD55C \uBA85\uC529 \uADF8\uB9BC\uC744 \uADF8\uB9BD\uB2C8\uB2E4.\n\n\u2463
      \uAC80\uC99D \u2014 20\uCD08\n\uADF8\uB9BC\uC744 \uBCF4\uBA70 \uC758\uACAC\uC744
      \uB098\uB204\uACE0 \uC9C1\uC5C5 \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\n\u2461~\u2463\uB97C
      \uD55C \uBC88 \uB354 \uC9C4\uD589\uD55C \uB4A4 \uCD5C\uC885 \uD22C\uD45C\uB97C
      \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - title: "\uADF8\uB9BC\uACFC \uB77C\uC6B4\uB4DC \uADDC\uCE59"
    body: "\uADF8\uB9BC\uC740 \uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC2E4\uC2DC\uAC04\uC73C\uB85C
      \uBCF4\uC774\uC9C0\uB9CC,\n\uD604\uC7AC \uB204\uAC00 \uADF8\uB9AC\uB294\uC9C0\uB294
      \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC790\uC2E0\uC758 \uD134\uC5D0\uB294
      \uCE94\uBC84\uC2A4 \uD14C\uB450\uB9AC\uC640 \uB0B4 \uC2AC\uB86F\uC774 \uBE5B\uB0A9\uB2C8\uB2E4.\n\uD39C
      \uC0C9\uC0C1\uC744 \uC120\uD0DD\uD558\uACE0, \uB418\uB3CC\uB9AC\uAE30\uB85C
      \uCD5C\uADFC \uC790\uC2E0\uC758 \uC120\uC744 \uC9C0\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB9BC\uC744
      \uADF8\uB9AC\uC9C0 \uC54A\uC73C\uBA74 \uC2AC\uB86F\uC5D0 \u20183\uBC88\uC9F8
      - \uADF8\uB9BC \uBBF8\uC791\uC131\u2019\uCC98\uB7FC\n\uBBF8\uC791\uC131\uC790\uC758
      \uC2E0\uC6D0\uACFC \uD134 \uC21C\uC11C\uAC00 \uBAA8\uB450\uC5D0\uAC8C \uACF5\uAC1C\uB429\uB2C8\uB2E4.\n\n2\uB77C\uC6B4\uB4DC\uC5D0\uB294
      \uADF8\uB9BC\uACFC \uBBF8\uC791\uC131 \uAE30\uB85D\uC774 \uCD08\uAE30\uD654\uB418\uACE0,\n\uC9C8\uBB38\uACFC
      \uADF8\uB9AC\uB294 \uC21C\uC11C\uAC00 \uBC14\uB01D\uB2C8\uB2E4. \uC9C1\uC5C5\uACFC
      \uC81C\uC2DC\uC5B4\uB294 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - title: "\uD22C\uD45C\uC640 \uCD5C\uD6C4 \uBCC0\uB860"
    body: "2\uB77C\uC6B4\uB4DC \uAC80\uC99D\uC774 \uB05D\uB098\uBA74 10\uCD08 \uB3D9\uC548
      \uD22C\uD45C\uD569\uB2C8\uB2E4.\n\n\uC790\uC2E0\uC5D0\uAC8C\uB3C4 \uD22C\uD45C\uD560
      \uC218 \uC788\uC73C\uBA70, \uC2DC\uAC04 \uB0B4 \uC120\uD0DD\uC744 \uBCC0\uACBD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD22C\uD45C\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uAE30\uAD8C\uC73C\uB85C \uCC98\uB9AC\uB429\uB2C8\uB2E4.\n\n\uCD5C\uB2E4 \uB4DD\uD45C\uC790\uAC00
      \uB3D9\uC810\uC774\uBA74 \uB3D9\uC810\uC790\uB9CC \uB300\uC0C1\uC73C\uB85C\n10\uCD08\uAC04
      \uC7AC\uD22C\uD45C\uD569\uB2C8\uB2E4. \uB2E4\uC2DC \uB3D9\uC810\uC774\uBA74
      \uC7AC\uD22C\uD45C\uB97C \uBC18\uBCF5\uD569\uB2C8\uB2E4.\n\n\uD55C \uBA85\uC774
      \uC120\uC815\uB418\uBA74 15\uCD08\uAC04 \uCD5C\uD6C4 \uBCC0\uB860\uC744 \uC9C4\uD589\uD558\uBA70,\n\uC120\uC815\uB41C
      \uD50C\uB808\uC774\uC5B4\uB9CC \uADF8\uB9BC\uC744 \uADF8\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCD94\uAC00
      \uD22C\uD45C \uC5C6\uC774 \uACB0\uACFC\uAC00 \uACF5\uAC1C\uB429\uB2C8\uB2E4.\n\uCD5C\uD6C4
      \uBCC0\uB860 \uC911\uC5D0\uB294 \uC81C\uC2DC\uC5B4 \uB9DE\uD788\uAE30\uC5D0
      \uB3C4\uC804\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - title: "\uC2B9\uB9AC\uC640 \uBB34\uC2B9\uBD80"
    body: "\uC0AC\uC9DC\uAC00 \uAC80\uC99D \uC2DC\uAC04\uC5D0 \uC2DC\uBBFC\uC758
      \uC81C\uC2DC\uC5B4\uB97C \uB9DE\uD798\n\u2192 \uC0AC\uC9DC \uD654\uAC00 \uC2B9\uB9AC
      / \uC2DC\uBBFC \uD300 \uD328\uBC30\n\n\uC0AC\uC9DC\uAC00 \uC815\uB2F5\uC744
      \uBABB \uB9DE\uD788\uACE0, \uCD5C\uC885 \uD22C\uD45C\uB85C \uC9C0\uBAA9\uB428\n\u2192
      \uC2DC\uBBFC \uD300 \uC2B9\uB9AC / \uC0AC\uC9DC \uD654\uAC00 \uD328\uBC30\n\n\uC0AC\uC9DC\uAC00
      \uC815\uB2F5\uC744 \uBABB \uB9DE\uD788\uACE0, \uB2E4\uB978 \uC0AC\uB78C\uC774
      \uCD5C\uC885 \uC120\uC815\uB428\n\u2192 \uC804\uC6D0 \uBB34\uC2B9\uBD80\n\n\uCD5C\uC885
      \uD22C\uD45C\uC5D0\uC11C \uC804\uC6D0 \uAE30\uAD8C\n\u2192 \uC804\uC6D0 \uBB34\uC2B9\uBD80\n\n\uACB0\uACFC
      \uCC3D\uC5D0\uB294 \uBAA8\uB4E0 \uC9C1\uC5C5\uACFC \uBC1B\uC740 \uC81C\uC2DC\uC5B4\uAC00
      \uACF5\uAC1C\uB429\uB2C8\uB2E4.\n\uB300\uAE30\uC2E4\uB85C \uB3CC\uC544\uC628
      \uB4A4 \uACB0\uACFC \uCC3D\uC740 \uAC01\uC790 \uB2EB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
