      m_Calls: []
  m_text: "\uC9C8\uBB38\uACFC \uC81C\uC2DC\uC5B4\uB97C \uC5F0\uACB0\uD574 \uADF8\uB9BC\uC744
    \uADF8\uB9AC\uACE0, \uC81C\uC2DC\uC5B4\uB97C \uBAA8\uB974\uB294 \u2018\uC0AC\uC9DC
    \uD654\uAC00\u2019\uB97C \uCC3E\uC544\uB0B4\uC138\uC694!\n\n\uCC38\uC5EC \uC778\uC6D0:
    4~8\uBA85 / \uD55C \uAC8C\uC784: \uCD1D 2\uB77C\uC6B4\uB4DC\n\n4\uBA85: \uC0AC\uC9DC
    \uD654\uAC00 1\uBA85, \uAC10\uC815\uAC00 1\uBA85, \uC2DC\uBBFC 2\uBA85\n5\uBA85
    \uC774\uC0C1: \uC0AC\uC9DC \uD654\uAC00 1\uBA85, \uAC10\uC815\uAC00 1\uBA85 \uACE0\uC815\n\uC54C\uCF54\uC62C
    \uC911\uB3C5 \uD654\uAC00 0~1\uBA85 \uBB34\uC791\uC704 \uBC30\uC815, \uB098\uBA38\uC9C0\uB294
    \uC2DC\uBBFC\n\n\uBAA8\uB4E0 \uD50C\uB808\uC774\uC5B4\uAC00 \uC900\uBE44\uD558\uBA74
    \uD638\uC2A4\uD2B8\uAC00 \uAC8C\uC784\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
